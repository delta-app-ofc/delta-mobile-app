<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="12dp" />
            <gradient
                android:angle="0"
                android:startColor="#285BBF"
                android:endColor="#6486CA" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape>
            <solid android:color="#252830" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
