        <shape>
            <corners android:radius="6dp"/>
            <solid android:color="#424242"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="6dp"/>
                <solid android:color="#86A5E6"/>
            </shape>
        </clip>
    </item>
</layer-list>
