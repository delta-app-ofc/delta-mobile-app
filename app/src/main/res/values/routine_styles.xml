<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="routine_background">#1B1D1E</color>
    <color name="routine_surface">#252C38</color>
    <color name="routine_card">#202D35</color>
    <color name="routine_border">#648CA5</color>
    <color name="routine_text">#FFFFFF</color>
    <color name="routine_muted">#CDD3DC</color>
    <color name="routine_accent">#306BE5</color>
    <color name="routine_metric">#92B7FF</color>
    <color name="routine_timeline_divider">#34383A</color>
    <color name="routine_timeline_purple_surface">#351C34</color>
    <color name="routine_timeline_purple_stroke">#9D378F</color>
    <color name="routine_timeline_purple_accent">#E45AD1</color>
    <color name="routine_timeline_green_surface">#1C3429</color>
    <color name="routine_timeline_green_stroke">#347A56</color>
    <color name="routine_timeline_green_accent">#4CD98B</color>
    <color name="routine_timeline_blue_surface">#24323A</color>
    <color name="routine_timeline_blue_stroke">#5D89A4</color>
    <color name="routine_timeline_blue_accent">#75C6F2</color>
    <color name="routine_timeline_amber_surface">#382E20</color>
    <color name="routine_timeline_amber_stroke">#8A6A31</color>
    <color name="routine_timeline_amber_accent">#EAB54D</color>
    <style name="Routine.Body" parent="Home.Body">
        <item name="android:textColor">@color/routine_text</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Routine.Heading" parent="Routine.Body">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="Routine.Section" parent="Routine.Body">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="Routine.Caption" parent="Routine.Body">
        <item name="android:textColor">@color/routine_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Routine.Metric" parent="Routine.Body">
        <item name="android:textColor">@color/routine_metric</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Routine.TimelineTime" parent="Routine.Caption">
        <item name="android:textColor">@color/routine_muted</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Routine.TimelineName" parent="Routine.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Routine.TimelineEstimate" parent="Routine.Caption">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Routine.Action" parent="Widget.Material3.Button.TextButton">
        <item name="android:singleLine">false</item>
        <item name="android:minWidth">@dimen/routine_touch_size</item>
        <item name="android:minHeight">@dimen/routine_touch_size</item>
        <item name="android:textColor">@color/routine_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Routine.PrimaryAction" parent="Widget.Material3.Button">
        <item name="android:singleLine">false</item>
        <item name="android:minHeight">@dimen/routine_touch_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="backgroundTint">@color/routine_accent</item>
        <item name="cornerRadius">@dimen/routine_card_radius</item>
    </style>
    <style name="Routine.DetailAction" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/routine_border</item>
        <item name="android:textColor">@color/routine_text</item>
    </style>
    <style name="Routine.DetailDangerAction" parent="Routine.DetailAction">
        <item name="strokeColor">@color/auth_error</item>
        <item name="android:textColor">@color/auth_error</item>
    </style>
    <style name="Routine.Day" parent="Widget.Material3.Button">
        <item name="android:singleLine">false</item>
        <item name="android:minWidth">@dimen/routine_touch_size</item>
        <item name="android:minHeight">@dimen/routine_day_min_height</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/routine_day_padding</item>
        <item name="android:paddingEnd">@dimen/routine_day_padding</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/routine_day_radius</item>
    </style>
    <style name="Routine.Calendar" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/routine_accent</item>
        <item name="colorOnPrimary">@color/routine_text</item>
        <item name="colorSurface">@color/routine_background</item>
        <item name="colorSurfaceContainerHigh">@color/routine_surface</item>
        <item name="colorOnSurface">@color/routine_text</item>
        <item name="colorOnSurfaceVariant">@color/routine_muted</item>
    </style>
    <style name="Routine.DetailsDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/routine_background</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="colorPrimary">@color/routine_metric</item>
        <item name="colorOnSurface">@color/routine_text</item>
        <item name="colorSurface">@color/routine_background</item>
    </style>
    <style name="Routine.EditorDialog" parent="Routine.DetailsDialog">
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="Routine.FormField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">@color/routine_muted</item>
        <item name="boxStrokeColor">@color/routine_muted</item>
        <item name="errorTextColor">@color/auth_error</item>
    </style>
    <style name="Routine.FormError" parent="Routine.Caption">
        <item name="android:textColor">@color/auth_error</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>
</resources>
