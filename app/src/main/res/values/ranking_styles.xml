<resources>
    <style name="Ranking.Caption" parent="Home.Body">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Ranking.Position" parent="Home.Body">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Ranking.MetricRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="Ranking.MetricLabel" parent="Home.Body">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/profile_muted</item>
    </style>
    <style name="Ranking.MetricValue" parent="Home.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
