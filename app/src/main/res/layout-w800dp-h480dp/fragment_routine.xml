<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:id="@+id/routine_scroll">
        <LinearLayout
            android:id="@+id/routine_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/routine_page_padding"
            android:paddingEnd="@dimen/routine_page_padding"
            android:paddingTop="@dimen/routine_page_padding"
            android:paddingBottom="@dimen/routine_menu_clearance"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/routine_back"
                    android:layout_width="@dimen/routine_touch_size"
                    android:layout_height="@dimen/routine_touch_size"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/routine_back"
                    app:srcCompat="@drawable/hourly_icon_back"
                    app:tint="@color/routine_text" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/routine_refresh"
                    style="@style/Routine.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/routine_refresh" />
            </LinearLayout>
            <TextView
                style="@style/Routine.Heading"
                android:layout_marginTop="8dp"
                android:text="@string/routine_title" />
            <TextView
                style="@style/Routine.Caption"
                android:layout_marginTop="8dp"
                android:text="@string/routine_subtitle" />
            <LinearLayout
                android:id="@+id/routine_columns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/routine_section_spacing"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <LinearLayout
                    android:id="@+id/routine_calendar"
                    android:layout_width="@dimen/routine_calendar_width"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/routine_column_gap">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/routine_previous_month"
                            style="@style/Routine.Action"
                            android:layout_width="@dimen/routine_touch_size"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/routine_previous_month"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="@string/routine_previous_symbol"
                            android:textSize="28sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/routine_month"
                            style="@style/Routine.Action"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:contentDescription="@string/routine_choose_date" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/routine_next_month"
                            style="@style/Routine.Action"
                            android:layout_width="@dimen/routine_touch_size"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/routine_next_month"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="@string/routine_next_symbol"
                            android:textSize="28sp" />
                    </LinearLayout>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/routine_week_outset"
                        android:layout_marginEnd="@dimen/routine_week_outset"
                        app:cardBackgroundColor="@color/routine_surface"
                        app:cardCornerRadius="@dimen/routine_card_radius"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/routine_days"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:overScrollMode="never" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/routine_today"
                        style="@style/Routine.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="@string/routine_today" />
                    <com.aula.delta_mobile_app.view.StatusNoticeView
                        android:id="@+id/routine_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/routine_item_spacing" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/routine_retry"
                        style="@style/Routine.Action"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/routine_retry"
                        android:visibility="gone" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/routine_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/routine_section_spacing"
                        app:cardBackgroundColor="@color/routine_surface"
                        app:cardCornerRadius="@dimen/routine_card_radius"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/routine_card_padding"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Routine.Caption"
                                android:text="@string/routine_total_title" />
                            <TextView
                                android:id="@+id/routine_total"
                                style="@style/Routine.Metric"
                                android:layout_marginTop="8dp"
                                android:accessibilityLiveRegion="polite"
                                android:text="@string/routine_unavailable" />
                            <TextView
                                android:id="@+id/routine_subtotal"
                                style="@style/Routine.Caption"
                                android:layout_marginTop="8dp"
                                android:visibility="gone" />
                            <TextView
                                style="@style/Routine.Caption"
                                android:layout_marginTop="8dp"
                                android:text="@string/routine_estimate_disclaimer" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/routine_agenda"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/routine_agenda_title"
                        style="@style/Routine.Section" />
                    <com.aula.delta_mobile_app.view.StatusNoticeView
                        android:id="@+id/routine_data_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/routine_item_spacing" />
                    <LinearLayout
                        android:id="@+id/routine_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/routine_empty_min_height"
                        android:padding="@dimen/routine_card_padding"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/routine_empty_icon_size"
                            android:layout_height="@dimen/routine_empty_icon_size"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/auth_icon_calendar"
                            app:tint="@color/routine_metric" />
                        <TextView
                            style="@style/Routine.Section"
                            android:layout_marginTop="@dimen/routine_section_spacing"
                            android:gravity="center"
                            android:text="@string/routine_empty_title" />
                        <TextView
                            style="@style/Routine.Caption"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/routine_empty_description" />
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/routine_habits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/routine_item_spacing"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/routine_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:visibility="gone" />
</FrameLayout>
