<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@drawable/leak_surface">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="44dp"
        android:paddingBottom="136dp">
        <TextView
            style="@style/Leak.Title"
            android:layout_marginHorizontal="26dp"
            android:text="@string/leak_title" />
        <TextView
            style="@style/Leak.Subtitle"
            android:layout_marginHorizontal="26dp"
            android:layout_marginTop="6dp"
            android:text="@string/leak_subtitle" />
        <HorizontalScrollView
            android:id="@+id/leak_event_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:paddingHorizontal="30dp"
            android:clipToPadding="false"
            android:scrollbars="none">
            <LinearLayout android:id="@+id/leak_events" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
    </HorizontalScrollView>
            <com.aula.delta_mobile_app.view.StatusNoticeView
                android:id="@+id/leak_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="26dp"
                android:layout_marginTop="16dp"
                android:visibility="gone" />
            <Button
                android:id="@+id/leak_retry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="26dp"
                android:text="@string/leak_retry"
                android:visibility="gone" />
            <TextView
                style="@style/Leak.Section"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="24dp"
                android:text="@string/leak_night_title" />
            <TextView
                android:id="@+id/leak_volume"
                style="@style/Leak.Subtitle"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="6dp" />
            <com.aula.delta_mobile_app.view.LeakFlowChart
                android:id="@+id/leak_chart"
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/leak_chart_empty" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="26dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/leak_blue_card"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:orientation="vertical">
                <TextView
                    style="@style/Leak.Section"
                    android:text="@string/leak_actions"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:id="@+id/leak_action_valve"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:contentDescription="@string/leak_check_valve">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/leak_icon_valve"
                        android:importantForAccessibility="no" />
                    <TextView
                        style="@style/Leak.ActionLabel"
                        android:text="@string/leak_check_valve" />
                    <TextView style="@style/Leak.Pill" android:layout_width="100dp" android:paddingHorizontal="4dp" android:text="@string/leak_urgent" android:textColor="#BD0000" />
    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#A0FFFFFF" />
                    <LinearLayout
                        android:id="@+id/leak_action_pipes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:contentDescription="@string/leak_check_pipes">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/leak_icon_search"
                            android:importantForAccessibility="no" />
                        <TextView
                            style="@style/Leak.ActionLabel"
                            android:text="@string/leak_check_pipes" />
                        <TextView style="@style/Leak.Pill" android:layout_width="100dp" android:paddingHorizontal="4dp" android:text="@string/leak_recommended" android:textColor="#A88B00" />
    </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#A0FFFFFF" />
                        <LinearLayout
                            android:id="@+id/leak_action_alerts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:contentDescription="@string/leak_disable_alerts">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/leak_icon_silent"
                                android:importantForAccessibility="no" />
                            <TextView
                                style="@style/Leak.ActionLabel"
                                android:text="@string/leak_disable_alerts" />
                            <TextView style="@style/Leak.Pill" android:layout_width="100dp" android:paddingHorizontal="4dp" android:text="@string/leak_optional" android:textColor="#306BE5" />
    </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/leak_hourly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginStart="26dp"
                            android:layout_marginEnd="26dp"
                            android:layout_marginTop="36dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:background="@drawable/leak_detail_background"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:contentDescription="@string/leak_hourly_action">
                            <TextView
                                style="@style/Leak.ActionLabel"
                                android:text="@string/leak_hourly_action"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/leak_icon_arrow" android:importantForAccessibility="no" />
    </LinearLayout>
                            <LinearLayout
                                android:id="@+id/leak_abnormal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:layout_marginStart="26dp"
                                android:layout_marginEnd="26dp"
                                android:layout_marginTop="20dp"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="10dp"
                                android:background="@drawable/leak_detail_background"
                                android:gravity="center_vertical"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:contentDescription="@string/leak_abnormal_action">
                                <TextView
                                    style="@style/Leak.ActionLabel"
                                    android:text="@string/leak_abnormal_action"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/leak_icon_arrow" android:importantForAccessibility="no" />
    </LinearLayout>
                            </LinearLayout>
                        </ScrollView>
