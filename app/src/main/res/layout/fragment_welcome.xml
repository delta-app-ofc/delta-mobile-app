<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_dark">
    <TextView
        android:id="@+id/welcome_back"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:rotation="180"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:text="→"
        android:textColor="@color/auth_white"
        android:textSize="30sp"
        android:contentDescription="@string/auth_back" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:translationY="-90dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_welcome_title"
            android:textColor="@color/auth_white"
            android:textSize="32sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_welcome_message"
            android:textColor="@color/auth_white"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/welcome_continue" android:layout_width="160dp" android:layout_height="40dp" android:layout_marginTop="18dp" android:background="@drawable/auth_button_blue" android:gravity="center" android:text="@string/auth_lets_go" android:textColor="@color/auth_white" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>
        <ImageView android:layout_width="300dp" android:layout_height="290dp" android:layout_gravity="bottom|end" android:layout_marginEnd="-8dp" android:contentDescription="@string/auth_welcome_title" android:scaleType="fitCenter" android:src="@drawable/delta_welcome_mascot" />
</FrameLayout>
