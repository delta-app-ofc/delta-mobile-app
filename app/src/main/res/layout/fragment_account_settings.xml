<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_blue"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="40dp"
    android:paddingBottom="24dp"
    android:fillViewport="true"
    android:clipToPadding="true"
    android:scrollbars="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/config_back"
                android:layout_width="28dp"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="←"
                android:textColor="@color/auth_white"
                android:textSize="30sp"
                android:contentDescription="@string/auth_back" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_config_title"
                    android:textColor="@color/auth_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auth_config_subtitle" android:textColor="@color/auth_white" android:textSize="14sp" />
      </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/auth_info_background"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="@string/auth_config_info"
                android:textColor="@color/auth_muted"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/auth_reference_month"
                android:textColor="@color/auth_white"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/auth_field_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/month_previous"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/auth_white"
                    android:textSize="34sp"
                    android:contentDescription="Mês anterior" />
                <TextView
                    android:id="@+id/reference_month"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/auth_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView android:id="@+id/month_next" android:layout_width="72dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textColor="@color/auth_white" android:textSize="34sp" android:contentDescription="Próximo mês" />
    </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/auth_total_paid"
                    android:textColor="@color/auth_white"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/total_paid"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/auth_field_background"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/auth_white" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/auth_total_hint"
                    android:textColor="@color/auth_muted"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/auth_consumption"
                    android:textColor="@color/auth_white"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/consumption"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/auth_field_background"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/auth_white" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <TextView android:id="@+id/config_continue" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="14dp" android:background="@drawable/auth_button_navy" android:gravity="center" android:text="@string/auth_continue" android:textColor="@color/auth_white" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="24dp" />
  </LinearLayout>
            </ScrollView>
