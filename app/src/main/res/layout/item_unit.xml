<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:padding="16dp"
    android:orientation="vertical"
    android:background="@drawable/dash_card">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/profile_avatar"
            android:src="@drawable/main_icon_home"
            android:tint="@color/auth_muted"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/unit_name"
                style="@style/Home.Section"
                android:textStyle="bold"
                android:accessibilityHeading="true" />
            <TextView
                android:id="@+id/unit_consumption"
                style="@style/Home.Body"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:textColor="@color/profile_muted" />
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="@color/profile_muted"
        android:alpha="0.2" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/unit_select"
            style="@style/Profile.Action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/units_select" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/unit_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:text="@string/units_delete_action"
            android:contentDescription="@string/units_delete"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/white"
            app:backgroundTint="#C82F42"
            app:icon="@drawable/units_icon_delete"
            app:iconSize="18dp"
            app:iconTint="@color/white"
            app:iconGravity="textEnd"
            app:cornerRadius="24dp" />
    </LinearLayout>
</LinearLayout>
