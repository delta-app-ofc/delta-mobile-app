<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_blue"
    android:paddingStart="@dimen/auth_margin"
    android:paddingEnd="@dimen/auth_margin"
    android:paddingTop="16dp"
    android:paddingBottom="24dp"
    android:fillViewport="true"
    android:clipToPadding="true"
    android:scrollbars="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <include layout="@layout/auth_step_header" />
        <EditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_field_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/auth_field_background"
            android:hint="@string/auth_email"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/auth_white"
            android:textColorHint="@color/auth_muted"
            android:textSize="14sp" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_field_height"
            android:layout_marginTop="16dp">
            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/auth_field_background"
                android:hint="@string/auth_create_password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="54dp"
                android:singleLine="true"
                android:textColor="@color/auth_white"
                android:textColorHint="@color/auth_muted"
                android:textSize="14sp" />
            <ImageView android:id="@+id/password_visibility" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackgroundBorderless" android:layout_width="48dp" android:layout_height="match_parent" android:layout_gravity="end" android:contentDescription="Mostrar ou ocultar senha" android:padding="12dp" android:src="@drawable/auth_icon_eye" />
    </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_field_height"
                android:layout_marginTop="16dp">
                <EditText
                    android:id="@+id/password_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/auth_field_background"
                    android:hint="@string/auth_confirm_password"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="@color/auth_white"
                    android:textColorHint="@color/auth_muted"
                    android:textSize="14sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="54dp" />
                <ImageView android:padding="12dp" android:layout_height="match_parent" android:layout_gravity="end" android:focusable="true" android:id="@+id/password_confirm_visibility" android:layout_width="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="Mostrar senha" android:src="@drawable/auth_icon_eye" />
    </FrameLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <TextView android:id="@+id/step_continue" android:layout_width="match_parent" android:layout_height="@dimen/auth_button_height" android:layout_marginHorizontal="12dp" android:background="@drawable/auth_button_muted" android:gravity="center" android:text="@string/auth_continue" android:textColor="@color/auth_white" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="24dp" />
  </LinearLayout>
            </ScrollView>
