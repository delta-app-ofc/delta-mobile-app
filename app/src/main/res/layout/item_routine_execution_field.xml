<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.textfield.TextInputLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/routine_execution_layout"
    style="@style/Routine.FormField"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/routine_page_padding"
    android:layout_marginEnd="@dimen/routine_page_padding"
    android:layout_marginBottom="@dimen/routine_item_spacing">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/routine_execution_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/routine_touch_size"
        android:inputType="time"
        android:imeOptions="actionNext"
        android:saveEnabled="false"
        android:singleLine="true"
        android:textColor="@color/routine_text" />
</com.google.android.material.textfield.TextInputLayout>
