<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/routine_page_padding"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/routine_details_close"
            android:layout_width="@dimen/routine_touch_size"
            android:layout_height="@dimen/routine_touch_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/routine_details_close"
            android:padding="12dp"
            app:srcCompat="@drawable/hourly_icon_back"
            app:tint="@color/routine_text" />
        <TextView
            style="@style/Routine.Heading"
            android:layout_marginTop="@dimen/routine_item_spacing"
            android:text="@string/routine_details_title" />
        <TextView
            android:id="@+id/routine_details_context"
            style="@style/Routine.Caption"
            android:layout_marginTop="@dimen/routine_item_spacing" />
        <com.aula.delta_mobile_app.view.StatusNoticeView
            android:id="@+id/routine_details_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/routine_section_spacing" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/routine_details_retry"
            style="@style/Routine.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/routine_retry"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/routine_details_refresh"
            style="@style/Routine.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/routine_details_refresh"
            android:visibility="gone" />
        <FrameLayout
            android:id="@+id/routine_details_loading"
            android:layout_width="match_parent"
            android:layout_height="@dimen/routine_details_loading_height"
            android:layout_marginTop="@dimen/routine_section_spacing"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/routine_details_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/routine_section_spacing"
            android:orientation="vertical"
            android:visibility="gone">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/routine_surface"
                app:cardCornerRadius="@dimen/routine_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/routine_border"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/routine_card_padding"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/routine_details_icon_container"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/routine_details_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="14dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/routine_icon_drop" />
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/routine_details_name"
                            style="@style/Routine.Section" />
                        <TextView
                            android:id="@+id/routine_details_category"
                            style="@style/Routine.Caption"
                            android:layout_marginTop="4dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/routine_section_spacing"
                app:cardBackgroundColor="@color/routine_surface"
                app:cardCornerRadius="@dimen/routine_card_radius"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/routine_card_padding"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/routine_details_count"
                        style="@style/Routine.Body" />
                    <TextView
                        style="@style/Routine.Section"
                        android:layout_marginTop="@dimen/routine_item_spacing"
                        android:text="@string/routine_details_times_title" />
                    <TextView
                        android:id="@+id/routine_details_times"
                        style="@style/Routine.Body"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/routine_section_spacing"
                app:cardBackgroundColor="@color/routine_card"
                app:cardCornerRadius="@dimen/routine_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/routine_border"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/routine_card_padding"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/routine_details_execution_estimate"
                        style="@style/Routine.Caption" />
                    <TextView
                        style="@style/Routine.Body"
                        android:layout_marginTop="@dimen/routine_item_spacing"
                        android:text="@string/routine_details_daily_estimate" />
                    <TextView
                        android:id="@+id/routine_details_daily_estimate"
                        style="@style/Routine.Metric"
                        android:layout_marginTop="8dp" />
                    <TextView
                        style="@style/Routine.Caption"
                        android:layout_marginTop="@dimen/routine_item_spacing"
                        android:text="@string/routine_estimate_disclaimer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/routine_section_spacing"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/routine_details_edit"
                style="@style/Routine.DetailAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/routine_details_edit"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/routine_details_delete"
                style="@style/Routine.DetailDangerAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/routine_details_delete"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
