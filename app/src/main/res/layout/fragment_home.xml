<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none"
    android:background="@drawable/home_surface_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="128dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="9dp"
                android:background="@drawable/home_circle"
                android:src="@drawable/home_icon_person"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/home_greeting"
                    style="@style/Home.Body"
                    android:text="@string/home_greeting_default"
                    android:textStyle="bold" />
                <TextView style="@style/Home.Caption" android:text="@string/home_welcome" android:textColor="#AAAAAA" />
        </LinearLayout>
                <ImageButton
                    android:id="@+id/home_notifications"
                    style="@style/Home.HeaderAction"
                    android:src="@drawable/home_icon_bell"
                    android:contentDescription="@string/home_notifications" />
                <ImageButton android:id="@+id/home_settings" style="@style/Home.HeaderAction" android:src="@drawable/home_icon_settings" android:contentDescription="@string/home_settings" />
    </LinearLayout>
                <TextView
                    style="@style/Home.Section"
                    android:layout_marginTop="20dp"
                    android:text="@string/home_headline"
                    android:textStyle="bold"
                    android:textSize="21sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    style="@style/Home.Section"
                    android:layout_marginTop="18dp"
                    android:text="@string/home_general" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/home_summary_background"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:gravity="center"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="4dp"
                                android:src="@drawable/home_icon_drop"
                                android:importantForAccessibility="no" />
                            <TextView android:id="@+id/home_today" style="@style/Home.Metric" android:layout_width="wrap_content" android:gravity="center" android:text="@string/home_pending_metric" />
        </LinearLayout>
                            <TextView style="@style/Home.Caption" android:layout_marginTop="3dp" android:text="@string/home_today_label" android:gravity="center" android:maxLines="1" />
    </LinearLayout>
                            <View
                                android:layout_width="1dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center_vertical"
                                android:background="#70FFFFFF" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1.1"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingHorizontal="4dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="26dp"
                                    android:gravity="center"
                                    android:orientation="horizontal">
                                    <ImageView
                                        android:layout_width="19dp"
                                        android:layout_height="22dp"
                                        android:layout_marginEnd="4dp"
                                        android:src="@drawable/home_icon_calendar"
                                        android:importantForAccessibility="no" />
                                    <TextView android:id="@+id/home_month" style="@style/Home.Metric" android:layout_width="wrap_content" android:gravity="center" android:text="@string/home_pending_metric" />
        </LinearLayout>
                                    <TextView style="@style/Home.Caption" android:layout_marginTop="3dp" android:text="@string/home_month_label" android:gravity="center" android:maxLines="1" />
    </LinearLayout>
                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="36dp"
                                        android:layout_gravity="center_vertical"
                                        android:background="#70FFFFFF" />
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="0.95"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:paddingHorizontal="4dp">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="26dp"
                                            android:gravity="center"
                                            android:orientation="horizontal">
                                            <ImageView
                                                android:layout_width="19dp"
                                                android:layout_height="22dp"
                                                android:layout_marginEnd="4dp"
                                                android:src="@drawable/home_icon_money"
                                                android:importantForAccessibility="no" />
                                            <TextView android:id="@+id/home_cost" style="@style/Home.Metric" android:layout_width="wrap_content" android:gravity="center" android:text="@string/home_pending_metric" />
        </LinearLayout>
                                            <TextView style="@style/Home.Caption" android:layout_marginTop="3dp" android:text="@string/home_cost_label" android:gravity="center" android:maxLines="1" />
    </LinearLayout>
                                        </LinearLayout>
                                        <com.aula.delta_mobile_app.view.StatusNoticeView
                                            android:id="@+id/home_api_status"
                                            style="@style/Home.Caption"
                                            android:layout_marginTop="12dp"
                                            android:accessibilityLiveRegion="polite"
                                            android:visibility="gone" />
                                        <TextView
                                            style="@style/Home.Section"
                                            android:layout_marginTop="18dp"
                                            android:text="@string/home_efficiency" />
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="19dp"
                                            android:gravity="center_vertical">
                                            <com.aula.delta_mobile_app.view.HomeEfficiencyView
                                                android:id="@+id/home_efficiency_gauge"
                                                android:layout_width="0dp"
                                                android:layout_weight="1.24"
                                                android:layout_height="176dp" />
                                            <LinearLayout
                                                android:layout_width="0dp"
                                                android:layout_weight="1"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="18dp"
                                                android:orientation="vertical">
                                                <LinearLayout
                                                    android:id="@+id/home_goal"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:minHeight="80dp"
                                                    android:background="@drawable/home_outline_background"
                                                    android:paddingHorizontal="14dp"
                                                    android:paddingTop="16dp"
                                                    android:paddingBottom="6dp"
                                                    android:orientation="vertical"
                                                    android:clickable="true"
                                                    android:focusable="true"
                                                    android:foreground="?attr/selectableItemBackground"
                                                    android:contentDescription="@string/home_goal_action">
                                                    <LinearLayout
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content"
                                                        android:gravity="bottom">
                                                        <TextView
                                                            style="@style/Home.Body"
                                                            android:layout_width="0dp"
                                                            android:layout_weight="1"
                                                            android:text="@string/home_monthly_goal"
                                                            android:textSize="12sp" />
                                                        <TextView android:id="@+id/home_goal_percent" style="@style/Home.Metric" android:text="@string/home_pending_metric" android:layout_marginStart="4dp" />
                </LinearLayout>
                                                        <ProgressBar
                                                            android:id="@+id/home_goal_progress"
                                                            style="?android:attr/progressBarStyleHorizontal"
                                                            android:layout_width="match_parent"
                                                            android:layout_height="11dp"
                                                            android:layout_marginTop="8dp"
                                                            android:progress="0"
                                                            android:progressDrawable="@drawable/home_goal_progress"
                                                            android:importantForAccessibility="no" />
                                                        <TextView style="@style/Home.Caption" android:layout_marginTop="4dp" android:text="@string/home_view_more" android:textSize="9sp" android:gravity="end" />
            </LinearLayout>
                                                        <LinearLayout
                                                            android:id="@+id/home_goal_suggestion"
                                                            android:layout_width="match_parent"
                                                            android:layout_height="wrap_content"
                                                            android:minHeight="80dp"
                                                            android:layout_marginTop="12dp"
                                                            android:background="@drawable/home_suggestion_background"
                                                            android:paddingHorizontal="14dp"
                                                            android:paddingTop="20dp"
                                                            android:paddingBottom="6dp"
                                                            android:orientation="vertical"
                                                            android:clickable="true"
                                                            android:focusable="true"
                                                            android:foreground="?attr/selectableItemBackground"
                                                            android:contentDescription="@string/home_suggestion">
                                                            <TextView
                                                                style="@style/Home.Body"
                                                                android:layout_height="42dp"
                                                                android:gravity="center"
                                                                android:text="@string/home_suggestion"
                                                                android:textStyle="bold"
                                                                android:textSize="12sp" />
                                                            <TextView style="@style/Home.Caption" android:text="@string/home_view_more" android:textSize="9sp" android:gravity="end" />
            </LinearLayout>
                                                        </LinearLayout>
                                                    </LinearLayout>
                                                    <LinearLayout
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content"
                                                        android:layout_marginHorizontal="8dp"
                                                        android:layout_marginTop="30dp"
                                                        android:orientation="vertical"
                                                        android:paddingHorizontal="16dp"
                                                        android:paddingTop="16dp"
                                                        android:paddingBottom="6dp"
                                                        android:background="@drawable/home_recommendation_background">
                                                        <LinearLayout
                                                            android:layout_width="match_parent"
                                                            android:layout_height="wrap_content"
                                                            android:gravity="center">
                                                            <ImageView
                                                                android:layout_width="24dp"
                                                                android:layout_height="24dp"
                                                                android:layout_marginEnd="6dp"
                                                                android:src="@drawable/home_icon_bulb"
                                                                android:importantForAccessibility="no" />
                                                            <TextView style="@style/Home.Section" android:layout_width="wrap_content" android:text="@string/home_stay_on_target" android:textStyle="bold" />
        </LinearLayout>
                                                            <Space
                                                                android:layout_width="1dp"
                                                                android:layout_height="8dp" />
                                                            <LinearLayout
                                                                android:layout_width="match_parent"
                                                                android:layout_height="wrap_content"
                                                                android:minHeight="34dp"
                                                                android:gravity="center_vertical">
                                                                <TextView
                                                                    style="@style/Home.Body"
                                                                    android:layout_width="0dp"
                                                                    android:layout_weight="1"
                                                                    android:text="@string/home_daily_limit" />
                                                                <TextView android:id="@+id/home_daily_limit" style="@style/Home.Caption" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:text="@string/home_pending_metric" android:textColor="#76E3D0" />
    </LinearLayout>
                                                                <View
                                                                    android:layout_width="match_parent"
                                                                    android:layout_height="1dp"
                                                                    android:background="#75FFFFFF" />
                                                                <LinearLayout
                                                                    android:layout_width="match_parent"
                                                                    android:layout_height="wrap_content"
                                                                    android:minHeight="34dp"
                                                                    android:gravity="center_vertical">
                                                                    <TextView
                                                                        style="@style/Home.Body"
                                                                        android:layout_width="0dp"
                                                                        android:layout_weight="1"
                                                                        android:text="@string/home_reduction" />
                                                                    <TextView android:id="@+id/home_reduction" style="@style/Home.Caption" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:text="@string/home_pending_metric" android:textColor="#EF909A" />
    </LinearLayout>
                                                                    <View
                                                                        android:layout_width="match_parent"
                                                                        android:layout_height="1dp"
                                                                        android:background="#75FFFFFF" />
                                                                    <LinearLayout
                                                                        android:layout_width="match_parent"
                                                                        android:layout_height="wrap_content"
                                                                        android:minHeight="34dp"
                                                                        android:gravity="center_vertical">
                                                                        <TextView
                                                                            style="@style/Home.Body"
                                                                            android:layout_width="0dp"
                                                                            android:layout_weight="1"
                                                                            android:text="@string/home_savings" />
                                                                        <TextView android:id="@+id/home_savings" style="@style/Home.Caption" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:text="@string/home_pending_metric" android:textColor="#FFFFFF" />
    </LinearLayout>
                                                                    </LinearLayout>
                                                                    <TextView
                                                                        style="@style/Home.Section"
                                                                        android:layout_marginTop="22dp"
                                                                        android:text="@string/home_temperature_title" />
                                                                    <com.aula.delta_mobile_app.view.HomeTemperatureChart android:id="@+id/home_chart" android:layout_width="match_parent" android:layout_height="132dp" android:layout_marginTop="12dp" android:contentDescription="@string/home_temperature_empty" />
</LinearLayout>
                                                                </ScrollView>
