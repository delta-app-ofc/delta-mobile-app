<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_dark"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="226dp"
        android:background="@color/auth_blue"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp">
        <include layout="@layout/auth_step_header" />
    </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="56dp"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="20dp">
            <androidx.camera.view.PreviewView
                android:id="@+id/camera_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/auth_camera_preview" />
            <view
                android:id="@+id/scanner_frame"
                class="com.aula.delta_mobile_app.view.fragments.QrScanFragment$ScannerFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />
            <com.aula.delta_mobile_app.view.StatusNoticeView android:id="@+id/camera_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" android:accessibilityLiveRegion="polite" />
    </FrameLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/auth_qr_help"
                android:textColor="@color/auth_white"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/qr_manual"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="42dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/auth_button_white"
                android:gravity="center"
                android:text="@string/auth_qr_manual"
                android:textColor="@color/auth_blue"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/qr_back_bottom" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="38dp" android:layout_marginTop="40dp" android:layout_marginBottom="24dp" android:background="@drawable/auth_button_muted" android:gravity="center" android:text="@string/auth_back" android:textColor="@color/auth_white" android:textSize="20sp" android:textStyle="bold" />
</LinearLayout>
