<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_blue"
    android:fillViewport="true"
    android:clipToPadding="true"
    android:scrollbars="vertical"
    android:paddingStart="@dimen/auth_margin"
    android:paddingEnd="@dimen/auth_margin"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <include layout="@layout/auth_step_header" />
        <EditText
            android:id="@+id/full_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_field_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/auth_field_background"
            android:hint="@string/auth_full_name"
            android:inputType="textCapWords"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/auth_white"
            android:textColorHint="@color/auth_muted"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/birth_date"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_field_height"
            android:layout_marginTop="16dp"
            android:background="@drawable/auth_field_background"
            android:drawableEnd="@drawable/auth_icon_calendar"
            android:drawablePadding="8dp"
            android:hint="@string/auth_birth_date"
            android:focusable="false"
            android:clickable="true"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/auth_white"
            android:textColorHint="@color/auth_muted"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/phone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_field_height"
            android:layout_marginTop="16dp"
            android:background="@drawable/auth_field_background"
            android:hint="@string/auth_phone"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/auth_white"
            android:textColorHint="@color/auth_muted"
            android:textSize="14sp" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView android:layout_marginTop="24dp" android:id="@+id/step_continue" android:layout_width="match_parent" android:layout_height="@dimen/auth_button_height" android:layout_marginHorizontal="12dp" android:background="@drawable/auth_button_muted" android:gravity="center" android:text="@string/auth_continue" android:textColor="@color/auth_white" android:textSize="20sp" android:textStyle="bold" />
</LinearLayout>
    </ScrollView>
