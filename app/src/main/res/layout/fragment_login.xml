<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_dark"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:fillViewport="true"
    android:clipToPadding="true"
    android:scrollbars="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="124dp"
            android:gravity="center"
            android:text="@string/auth_login_title"
            android:textColor="@color/auth_white"
            android:textSize="32sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/auth_login_subtitle"
            android:textColor="@color/auth_white"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/login_user"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_field_height"
            android:layout_marginTop="30dp"
            android:background="@drawable/auth_dark_field_background"
            android:hint="@string/auth_user_email"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/auth_white"
            android:textColorHint="@color/auth_white"
            android:textSize="14sp" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_field_height"
            android:layout_marginTop="15dp">
            <EditText
                android:id="@+id/login_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/auth_dark_field_background"
                android:hint="@string/auth_password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/auth_white"
                android:textColorHint="@color/auth_white"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="54dp" />
            <ImageView android:padding="12dp" android:layout_height="match_parent" android:layout_gravity="end" android:focusable="true" android:id="@+id/login_password_visibility" android:layout_width="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="Mostrar senha" android:src="@drawable/auth_icon_eye" />
    </FrameLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:text="@string/auth_social"
                android:visibility="gone"
                android:textColor="@color/auth_white"
                android:textSize="16sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/social_facebook"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="f"
                    android:textColor="@color/auth_white"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:contentDescription="Facebook" />
                <TextView
                    android:id="@+id/social_apple"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="12dp"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="@color/auth_white"
                    android:textSize="26sp"
                    android:contentDescription="Apple" />
                <TextView android:id="@+id/social_google" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="G" android:textColor="@color/auth_white" android:textSize="26sp" android:textStyle="bold" android:contentDescription="Google" />
    </LinearLayout>
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/login_remember_me"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Lembrar de mim"
                    android:textColor="@color/auth_white" />
                <TextView
                    android:id="@+id/login_register"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/auth_register"
                    android:textColor="@color/auth_white"
                    android:textSize="14sp" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <TextView android:id="@+id/login_continue" android:layout_width="match_parent" android:layout_height="@dimen/auth_button_height" android:layout_marginHorizontal="10dp" android:background="@drawable/auth_button_continue" android:gravity="center" android:text="@string/auth_continue" android:textColor="@color/auth_white" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="24dp" />
  </LinearLayout>
            </ScrollView>
