<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/routine_form_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/routine_form_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/routine_form_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/routine_page_padding">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/routine_form_close"
                style="@style/Routine.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/routine_details_close" />
            <TextView
                android:id="@+id/routine_form_title"
                style="@style/Routine.Heading"
                android:layout_marginTop="@dimen/routine_item_spacing" />
            <TextView
                style="@style/Routine.Caption"
                android:layout_marginTop="8dp"
                android:text="@string/routine_form_help" />
            <TextView
                android:id="@+id/routine_form_effective_from"
                style="@style/Routine.Caption"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
            <com.aula.delta_mobile_app.view.StatusNoticeView
                android:id="@+id/routine_form_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/routine_item_spacing" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/routine_form_type_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/routine_section_spacing"
                android:hint="@string/routine_form_type">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/routine_form_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/routine_touch_size"
                    android:inputType="none"
                    android:saveEnabled="false"
                    android:textColor="@color/routine_text" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                style="@style/Routine.Section"
                android:layout_marginTop="@dimen/routine_section_spacing"
                android:labelFor="@id/routine_form_days"
                android:text="@string/routine_form_when" />
            <TextView
                style="@style/Routine.Caption"
                android:layout_marginTop="4dp"
                android:text="@string/routine_form_days_help" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/routine_form_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
            <TextView
                android:id="@+id/routine_form_days_error"
                style="@style/Routine.FormError"
                android:labelFor="@id/routine_form_days"
                android:text="@string/routine_form_days_required"
                android:visibility="gone" />
            <TextView
                android:id="@+id/routine_form_distribution_error"
                style="@style/Routine.FormError"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/routine_form_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/routine_item_spacing"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/routine_form_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/routine_background"
        android:orientation="vertical"
        android:paddingStart="@dimen/routine_page_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/routine_page_padding"
        android:paddingBottom="12dp">
        <TextView
            android:id="@+id/routine_form_summary"
            style="@style/Routine.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/routine_form_save"
            style="@style/Routine.PrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/routine_form_save" />
    </LinearLayout>
</LinearLayout>
