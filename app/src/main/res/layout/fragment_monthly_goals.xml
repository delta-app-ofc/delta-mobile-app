<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/monthly_goal_screen_background"
    android:orientation="vertical"
    android:focusableInTouchMode="true">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/goal_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="21dp"
            android:paddingTop="24dp"
            android:paddingBottom="136dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <ImageButton
                    android:id="@+id/goal_back"
                    style="@style/Profile.IconButton"
                    android:layout_marginStart="-12dp"
                    android:src="@drawable/profile_back"
                    android:contentDescription="@string/goal_back" />
                <ImageButton
                    android:id="@+id/goal_edit"
                    style="@style/Profile.IconButton"
                    android:layout_gravity="end"
                    android:src="@drawable/profile_edit"
                    android:contentDescription="@string/goal_edit" />
            </FrameLayout>
            <TextView
                style="@style/Profile.Title"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="7dp"
                android:text="@string/goal_title"
                android:accessibilityHeading="true" />
            <TextView
                style="@style/Home.Body"
                android:layout_marginTop="6dp"
                android:layout_marginHorizontal="7dp"
                android:text="@string/goal_description"
                android:textColor="#BBBBBB" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/monthly_goal_surface">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/monthly_goal_house"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Home.Body"
                        android:textSize="12sp"
                        android:text="@string/goal_current_residence"
                        android:textColor="#999DA5" />
                    <TextView
                        android:id="@+id/goal_property"
                        style="@style/Home.Section"
                        android:layout_marginTop="4dp"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="22dp"
                android:paddingVertical="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/monthly_goal_surface">
                <ImageButton
                    android:id="@+id/goal_previous"
                    style="@style/Profile.IconButton"
                    android:src="@drawable/monthly_goal_chevron"
                    android:contentDescription="@string/goal_previous" />
                <TextView
                    android:id="@+id/goal_month"
                    style="@style/Home.Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:accessibilityLiveRegion="polite" />
                <ImageButton
                    android:id="@+id/goal_next"
                    style="@style/Profile.IconButton"
                    android:src="@drawable/monthly_goal_chevron"
                    android:rotation="180"
                    android:contentDescription="@string/goal_next" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="170dp"
                android:layout_marginTop="20dp"
                android:padding="14dp"
                android:orientation="vertical"
                android:background="@drawable/monthly_goal_limit_background">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/home_icon_target"
                        android:tint="@color/white"
                        android:importantForAccessibility="no" />
                    <TextView
                        style="@style/Home.Body"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:textSize="17sp"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeMaxTextSize="17sp"
                        android:text="@string/goal_limit_label" />
                </LinearLayout>
                <TextView
                    android:id="@+id/goal_confirmed"
                    style="@style/Home.Body"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="96dp"
                    android:gravity="center_vertical"
                    android:textSize="40sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="40sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textStyle="bold"
                    android:accessibilityLiveRegion="polite" />
                <LinearLayout
                    android:id="@+id/goal_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/goal_amount_field"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="#33FFFFFF"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/white"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:errorTextColor="@color/white"
                        app:suffixText="@string/goal_liters_unit"
                        app:suffixTextColor="@color/white"
                        app:hintEnabled="false">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/goal_amount_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:background="@null"
                            android:contentDescription="@string/goal_amount"
                            android:hint="@string/goal_new_amount_hint"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionDone"
                            android:maxLines="1"
                            android:padding="14dp"
                            android:saveEnabled="false"
                            android:textColor="@color/white"
                            android:textColorHint="#CCFFFFFF"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/goal_limit_hint"
                    style="@style/Home.Body"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeStepGranularity="1sp"
                    android:text="@string/goal_limit_hint" />
            </LinearLayout>
            <com.aula.delta_mobile_app.view.StatusNoticeView
                android:id="@+id/goal_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/goal_retry"
                style="@style/Profile.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:text="@string/profile_retry" />
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/goal_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="21dp"
        android:paddingTop="4dp"
        android:paddingBottom="136dp"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/goal_save"
            style="@style/Goal.PrimaryAction"
            android:layout_width="wrap_content"
            android:minWidth="164dp"
            android:layout_gravity="end"
            android:layout_marginTop="0dp"
            android:text="@string/goal_save" />
    </FrameLayout>
</LinearLayout>
