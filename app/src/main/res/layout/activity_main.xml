<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_shell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/main_nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true" />
    <FrameLayout
        android:id="@+id/main_menu"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="24dp">
        <com.aula.delta_mobile_app.view.FloatingMenuBackground
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent">
                <ImageButton
                    android:id="@+id/menu_consumption"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:padding="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/main_icon_consumption"
                    android:contentDescription="@string/leak_title" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent">
                <ImageButton
                    android:id="@+id/menu_costs"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:padding="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/main_icon_costs"
                    android:contentDescription="@string/main_costs" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent">
                <ImageButton
                    android:id="@+id/menu_home"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|center_horizontal"
                    android:padding="11dp"
                    android:background="@drawable/main_home_background"
                    android:src="@drawable/main_icon_home"
                    android:contentDescription="@string/main_home" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent">
                <ImageButton
                    android:id="@+id/menu_tips"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:padding="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/main_icon_tips"
                    android:contentDescription="@string/main_tips" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent">
                <ImageButton
                    android:id="@+id/menu_goals"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:padding="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/main_icon_goals"
                    android:contentDescription="@string/main_goals" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
